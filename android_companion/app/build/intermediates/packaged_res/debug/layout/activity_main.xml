<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏃 TMM 2027 AUDIO COMPANION"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvWorkoutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Long Run • 7.0 km"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvTargetPace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Target: 7:35 - 7:45 min/km (RPE 3/10)"
            android:textColor="#F59E0B"
            android:textSize="15sp"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/tvWeatherAdvisory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Sunday, Aug 23 • Post-run calf armor flush"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Feature Toggle: Metronome -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🥁 Cadence Metronome (170 SPM)"
                android:textColor="#E2E8F0"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchMetronome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="UseSwitchCompatOrMaterialXml" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎧 YouTube Music will automatically duck to 10% 1.5s before cues."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#131C31"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION STATUS"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready. Start YouTube Music, then tap 'START RUN'."
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- SECTION 1: VISUAL RUN AUDIO TIMELINE                          -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0F172A"
            android:padding="16dp"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 AUDIO TRIGGER TIMELINE"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7 Milestones"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:background="#1E293B"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <!-- Timeline Node 0: Start -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 km (00:00) • Kickoff Briefing (10% Ducking)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Morning weather advisory &amp; 7:35-7:45 min/km pace target."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Timeline Node 1: Km 1 Split -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔵"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0 km • Rhythm Check"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gently float into rhythm. Do not start too fast."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Timeline Node 2: Km 3 Split -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔵"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.0 km • Cadence Sync (168-172 SPM)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smooth aerobic cruising pace."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Timeline Node 3: 45 Min Salt Capsule (COMPULSORY) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟡"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45:00 Min • Anti-Cramp Salt Capsule (COMPULSORY)"
                        android:textColor="#F59E0B"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Take 1 Salt Capsule now with 150ml water to protect calves."
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Timeline Node 4: Km 5 Form Check -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔵"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5.0 km • Form &amp; Shoulder Check"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Relax neck &amp; shoulders, breathe into belly."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Timeline Node 5: Km 7 Finish -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏁"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7.0 km • Finish &amp; 10-Min Calf Flush"
                        android:textColor="#10B981"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Take 500ml electrolyte water &amp; begin calf prehab flush."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================= -->
        <!-- SECTION 2: YOUTUBE MUSIC STYLE SPOKEN AUDIO LYRICS VIEW      -->
        <!-- ============================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#060913"
            android:padding="16dp"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📜 SPOKEN AUDIO LYRICS"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 YOUTUBE MUSIC SYNC VIEW"
                    android:textColor="#EF4444"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Lyric Item 1 -->
            <LinearLayout
                android:id="@+id/cardLyric1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#131D33"
                android:padding="12dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:02 • START"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#1E293B"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp" />
                <TextView
                    android:id="@+id/tvLyric1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&quot;Welcome to your Sunday Long Run! Today's session is 7 kilometers. Target pace is 7:35 to 7:45 min/km with an RPE of 3. Morning temperature is 20°C with 93% humidity.&quot;"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Lyric Item 2 -->
            <LinearLayout
                android:id="@+id/cardLyric2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0A0F1D"
                android:padding="12dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0 KM • SPLIT"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#1E293B"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp" />
                <TextView
                    android:id="@+id/tvLyric2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&quot;Kilometer 1 reached. Gently float into your rhythm. Do not start too fast.&quot;"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Lyric Item 3 -->
            <LinearLayout
                android:id="@+id/cardLyric3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0A0F1D"
                android:padding="12dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45:00 MIN • FUELING"
                    android:textColor="#F59E0B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#27272A"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp" />
                <TextView
                    android:id="@+id/tvLyric3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&quot;45 minutes elapsed. Take 1 Salt Capsule now with 150 ml water to protect your calves from cramping.&quot;"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Lyric Item 4 -->
            <LinearLayout
                android:id="@+id/cardLyric4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0A0F1D"
                android:padding="12dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5.0 KM • CHECK"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#1E293B"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp" />
                <TextView
                    android:id="@+id/tvLyric4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&quot;Kilometer 5 reached. Check your posture, relax your shoulders, and keep your cadence smooth.&quot;"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Lyric Item 5 -->
            <LinearLayout
                android:id="@+id/cardLyric5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0A0F1D"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7.0 KM • FINISH"
                    android:textColor="#10B981"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#1E293B"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp" />
                <TextView
                    android:id="@+id/tvLyric5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&quot;Workout complete! Fantastic work on completing today's 7km long run. Take 500 ml electrolyte water and perform your 10-minute calf and quad flush.&quot;"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnSundayTest"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🏃 PREVIEW SUNDAY 7KM RUN AUDIO"
            android:backgroundTint="#065F46"
            android:textColor="#34D399"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnFastTest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚡ TEST SPEED INTERVALS &amp; COUNTDOWN (60s)"
            android:backgroundTint="#1E293B"
            android:textColor="#38BDF8"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="START RUN (GPS + LIVE CUES)"
            android:backgroundTint="#10B981"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
