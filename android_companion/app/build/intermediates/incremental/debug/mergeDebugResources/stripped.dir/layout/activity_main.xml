<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/swiss_canvas">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="36dp">

            <!-- 1. Swiss Header Card with Brushed Conical Steel Badge -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeWidth="2.5dp"
                app:strokeColor="@color/swiss_border"
                app:cardBackgroundColor="@color/swiss_card_rustic_yellow"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TMM 2027"
                                android:textColor="#111111"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:letterSpacing="-0.03" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="."
                                android:textColor="#F95700"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MARATHON AUDIO COMPANION"
                            android:textColor="#6B7280"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.06"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Conical Brushed Steel Metallic Badge -->
                    <com.tmm2027.runner.ConicalSteelBadgeView
                        android:id="@+id/conicalSteelBadge"
                        android:layout_width="68dp"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Signature Split Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeWidth="2.5dp"
                app:strokeColor="@color/swiss_border"
                app:cardBackgroundColor="@color/swiss_card_rustic_yellow"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="136dp"
                    android:orientation="horizontal">

                    <!-- Left Column: 45° Hatch + Orange Metric -->
                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <!-- 45° Diagonal Industrial Hatching -->
                        <com.tmm2027.runner.DiagonalHatchView
                            android:layout_width="match_parent"
                            android:layout_height="44dp" />

                        <!-- Horizontal 2.5dp divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2.5dp"
                            android:background="#111111" />

                        <!-- Orange Metric Box -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:minHeight="75dp"
                            android:orientation="vertical"
                            android:background="#F95700"
                            android:gravity="center"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                android:id="@+id/tvHeroDistanceNum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="7.0"
                                android:textColor="#111111"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.03"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvHeroDistanceUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KM"
                                android:textColor="#111111"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.05"
                                android:layout_marginTop="2dp"
                                android:gravity="center" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Vertical 2.5dp black divider -->
                    <View
                        android:layout_width="2.5dp"
                        android:layout_height="match_parent"
                        android:background="#111111" />

                    <!-- Right Column: Day Carousel & Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="14dp">

                        <!-- Monospaced Day Carousel Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingBottom="6dp">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnPrevDay"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="←"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_swiss_square_btn"
                                app:backgroundTint="@null"
                                android:padding="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvDayLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="day: SUNDAY (AUG 23)"
                                android:textColor="#6B7280"
                                android:textSize="10.5sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:gravity="center" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnNextDay"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="→"
                                android:textColor="#111111"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_swiss_square_btn"
                                app:backgroundTint="@null"
                                android:padding="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Hairline divider below carousel -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1.5dp"
                            android:background="@color/swiss_divider"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvWorkoutTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Long Run"
                            android:textColor="#111111"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02" />

                        <TextView
                            android:id="@+id/tvTargetPace"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Target: 7:35 – 7:45 min/km"
                            android:textColor="#F95700"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvWeatherAdvisory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="RPE 3/10 • Post-run 10-min calf flush"
                            android:textColor="#6B7280"
                            android:textSize="11sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- 3. Cadence Metronome Module -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeWidth="2.5dp"
                app:strokeColor="@color/swiss_border"
                app:cardBackgroundColor="@color/swiss_card_rustic_yellow"
                app:cardElevation="0dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CADENCE: METRONOME"
                            android:textColor="#6B7280"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/tvLiveCadenceBpm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="170 SPM"
                            android:textColor="#F95700"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinnerCadence"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_swiss_input"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:spinnerMode="dropdown"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="In Auto-Pace mode, cadence dynamically shifts if you're slower/faster than goal pace."
                        android:textColor="#6B7280"
                        android:textSize="10sp"
                        android:lineSpacingExtra="1dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Audio Trigger Timeline Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeWidth="2.5dp"
                app:strokeColor="@color/swiss_border"
                app:cardBackgroundColor="@color/swiss_card_rustic_yellow"
                app:cardElevation="0dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AUDIO TRIGGERS &amp; SPLITS"
                            android:textColor="#6B7280"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/tvTimelineCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 MILESTONES"
                            android:textColor="#6B7280"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <!-- Hairline divider below header -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/swiss_divider"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/layoutTimelineContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Spoken Audio Lyrics Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeWidth="2.5dp"
                app:strokeColor="@color/swiss_border"
                app:cardBackgroundColor="@color/swiss_card_rustic_yellow"
                app:cardElevation="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SPOKEN AUDIO STREAM"
                            android:textColor="#6B7280"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIVE SYNC"
                            android:textColor="#F95700"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <!-- Hairline divider below header -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/swiss_divider"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/layoutLyricsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5b. Sunday 6:00 PM Proactive Debrief Notification Trigger Button -->
            <Button
                android:id="@+id/btnSundayDebriefTest"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🧪 TEST SUNDAY 6:00 PM PHONE NOTIFICATION →"
                android:background="@drawable/bg_swiss_btn_red"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:layout_marginBottom="12dp" />

            <!-- 6. Master Industrial Action Button -->
            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="START RUN [GPS + AUDIO] →"
                android:background="@drawable/bg_swiss_btn_black"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.04" />

        </LinearLayout>
    </ScrollView>

    <!-- 35mm Analog Film Grain Overlay on Clean White Canvas -->
    <com.tmm2027.runner.GrainOverlayView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>

